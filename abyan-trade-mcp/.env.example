# Alpaca Broker API correspondent credentials from Brokerdash.
# Never commit real values. The MCP server reads these from the environment.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# sandbox (default) or live
ALPACA_BROKER_ENV=sandbox

# Optional URL overrides. Defaults:
# sandbox broker: https://broker-api.sandbox.alpaca.markets
# live broker:    https://broker-api.alpaca.markets
# sandbox data:   https://data.sandbox.alpaca.markets
# live data:      https://data.alpaca.markets
# ALPACA_BROKER_BASE_URL=
# ALPACA_DATA_BASE_URL=
