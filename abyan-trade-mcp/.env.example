# Alpaca credentials. Never commit real values.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# auto (default): PK…/AK… keys or ALPACA_TRADING_ENV → Trading API; otherwise Broker API
# ALPACA_API_MODE=auto

# Trading API (dashboard paper/live keys). Paper keys start with PK.
ALPACA_TRADING_ENV=paper
# ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# Broker API (Brokerdash correspondent keys, HTTP Basic)
# ALPACA_BROKER_ENV=sandbox
# ALPACA_BROKER_BASE_URL=

# Optional Market Data host override
# ALPACA_DATA_BASE_URL=
